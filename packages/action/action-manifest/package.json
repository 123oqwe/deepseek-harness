{
  "name": "@deepseek-ai/dsh-action-manifest",
  "description": "Contract-stage type surface and pure decision logic for Epic P2-03's first-class ActionManifest: the durable pre-execution record every external write operation must carry, argument canonicalization/hashing, side-effect classification with a fail-closed default, and the manifest-precedes-execution ordering gate",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/action/action-manifest"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./canonicalize": {
      "types": "./lib/types/canonicalize.d.ts",
      "default": "./lib/types/canonicalize.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^"
  }
}
