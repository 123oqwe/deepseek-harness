{
  "name": "@deepseek-ai/dsh-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 2,
    "executionMode": "in-process",
    "compatibility": {
      "dshVersionRange": ">=0.1.0 <0.2.0"
    },
    "tools": [
      {
        "name": "bash",
        "sideEffectClass": "process",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [
          {
            "kind": "process",
            "commandPattern": "bash"
          }
        ],
        "dataClassification": "confidential"
      },
      {
        "name": "pwsh",
        "sideEffectClass": "process",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [
          {
            "kind": "process",
            "commandPattern": "pwsh"
          }
        ],
        "dataClassification": "confidential"
      },
      {
        "name": "run_code",
        "sideEffectClass": "process",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [
          {
            "kind": "process",
            "commandPattern": "*"
          }
        ],
        "dataClassification": "confidential"
      }
    ],
    "services": [
      {
        "ctxKey": "agentLoop",
        "role": "provides"
      },
      {
        "ctxKey": "agents",
        "role": "provides"
      },
      {
        "ctxKey": "deepseekLlmApiExtensions",
        "role": "provides"
      },
      {
        "ctxKey": "invariants",
        "role": "provides"
      },
      {
        "ctxKey": "jobs",
        "role": "provides"
      },
      {
        "ctxKey": "llm",
        "role": "provides"
      },
      {
        "ctxKey": "loggerStderr",
        "role": "provides"
      },
      {
        "ctxKey": "policy",
        "role": "provides"
      },
      {
        "ctxKey": "policySet",
        "role": "provides"
      },
      {
        "ctxKey": "sandbox",
        "role": "provides"
      },
      {
        "ctxKey": "sandboxPolicy",
        "role": "provides"
      },
      {
        "ctxKey": "sessionPersistence",
        "role": "provides"
      },
      {
        "ctxKey": "sessionProjections",
        "role": "provides"
      },
      {
        "ctxKey": "sessionTitle",
        "role": "provides"
      },
      {
        "ctxKey": "sessions",
        "role": "provides"
      },
      {
        "ctxKey": "settings",
        "role": "provides"
      },
      {
        "ctxKey": "subprocess",
        "role": "provides"
      },
      {
        "ctxKey": "systemPrompt",
        "role": "provides"
      },
      {
        "ctxKey": "terminals",
        "role": "provides"
      },
      {
        "ctxKey": "timer",
        "role": "provides"
      },
      {
        "ctxKey": "tools",
        "role": "provides"
      }
    ],
    "events": [
      {
        "name": "agent/request-error",
        "mode": "waterfall"
      },
      {
        "name": "agent/status",
        "mode": "emit"
      },
      {
        "name": "control/state-changed",
        "mode": "emit"
      },
      {
        "name": "internal/status",
        "mode": "emit"
      },
      {
        "name": "llm/stream",
        "mode": "waterfall"
      },
      {
        "name": "session/created",
        "mode": "emit"
      },
      {
        "name": "session/disposed",
        "mode": "emit"
      },
      {
        "name": "session/event",
        "mode": "emit"
      },
      {
        "name": "session/flush",
        "mode": "parallel"
      },
      {
        "name": "subagent/end",
        "mode": "emit"
      },
      {
        "name": "user-questions/request",
        "mode": "waterfall"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-timer": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-agent-loop": "workspace:^",
    "@deepseek-ai/dsh-deepseek-llm-api-extensions": "workspace:^",
    "@deepseek-ai/dsh-invariants": "workspace:^",
    "@deepseek-ai/dsh-jobs-local": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-llm-deepseek": "workspace:^",
    "@deepseek-ai/dsh-llm-retry": "workspace:^",
    "@deepseek-ai/dsh-logger-stderr": "workspace:^",
    "@deepseek-ai/dsh-plugin-package-inventory-deepseek": "workspace:^",
    "@deepseek-ai/dsh-policy-engine-cedar": "workspace:^",
    "@deepseek-ai/dsh-policy-language": "workspace:^",
    "@deepseek-ai/dsh-sandbox-local": "workspace:^",
    "@deepseek-ai/dsh-sandbox-policy": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-sdk-app": "workspace:^",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-session-log-deepseek": "workspace:^",
    "@deepseek-ai/dsh-session-persistence-jsonl": "workspace:^",
    "@deepseek-ai/dsh-session-projection": "workspace:^",
    "@deepseek-ai/dsh-session-title": "workspace:^",
    "@deepseek-ai/dsh-settings-file": "workspace:^",
    "@deepseek-ai/dsh-subprocess-local": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-terminal-bash": "workspace:^",
    "@deepseek-ai/dsh-tool-bash-persistent": "workspace:^",
    "@deepseek-ai/dsh-tool-pwsh-persistent": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
