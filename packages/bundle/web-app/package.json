{
  "name": "@deepseek-ai/dsh-web-app",
  "description": "The dsh browser-surface bundle: the web patch layer over dsh-base plus the runtime glue plugin (frontend dist serving, web-surface prompt, bash runtime variables, URL line)",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./startup": {
        "types": "./lib/types/startup.d.ts",
        "default": "./lib/startup.js"
      },
      "./cordis.patch.yml": "./cordis.patch.yml",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/web-app"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./startup": {
      "types": "./lib/types/startup.d.ts",
      "default": "./lib/startup.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/startup.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 2,
    "executionMode": "in-process",
    "compatibility": {
      "dshVersionRange": ">=0.1.0 <0.2.0"
    },
    "services": [
      {
        "ctxKey": "webStartup",
        "role": "provides"
      },
      {
        "ctxKey": "webRuntime",
        "role": "provides"
      },
      {
        "ctxKey": "agentPresets",
        "role": "provides"
      },
      {
        "ctxKey": "clientModules",
        "role": "provides"
      },
      {
        "ctxKey": "codeRuntime",
        "role": "provides"
      },
      {
        "ctxKey": "connection",
        "role": "provides"
      },
      {
        "ctxKey": "cordisInspect",
        "role": "provides"
      },
      {
        "ctxKey": "credentialsController",
        "role": "provides"
      },
      {
        "ctxKey": "directoryPickerController",
        "role": "provides"
      },
      {
        "ctxKey": "dynamicCordisRunner",
        "role": "provides"
      },
      {
        "ctxKey": "fileReferences",
        "role": "provides"
      },
      {
        "ctxKey": "fileUploads",
        "role": "provides"
      },
      {
        "ctxKey": "messageFeedback",
        "role": "provides"
      },
      {
        "ctxKey": "pluginInventory",
        "role": "provides"
      },
      {
        "ctxKey": "sessionController",
        "role": "provides"
      },
      {
        "ctxKey": "sessionFileReferences",
        "role": "provides"
      },
      {
        "ctxKey": "sessionReferenceResolver",
        "role": "provides"
      },
      {
        "ctxKey": "sessionSkillCatalog",
        "role": "provides"
      },
      {
        "ctxKey": "settingsController",
        "role": "provides"
      },
      {
        "ctxKey": "subagentModelSelection",
        "role": "provides"
      },
      {
        "ctxKey": "webServer",
        "role": "provides"
      },
      {
        "ctxKey": "workspaceController",
        "role": "provides"
      },
      {
        "ctxKey": "workspaceFiles",
        "role": "provides"
      },
      {
        "ctxKey": "workspaceRegistry",
        "role": "provides"
      }
    ],
    "events": [
      {
        "name": "agent-preset/selected",
        "mode": "emit"
      },
      {
        "name": "agent/assistant-stream",
        "mode": "emit"
      },
      {
        "name": "agent/created",
        "mode": "emit"
      },
      {
        "name": "agent/disposed",
        "mode": "emit"
      },
      {
        "name": "agent/error",
        "mode": "emit"
      },
      {
        "name": "agent/pre-step",
        "mode": "waterfall"
      },
      {
        "name": "agent/status",
        "mode": "emit"
      },
      {
        "name": "api-session/activity",
        "mode": "emit"
      },
      {
        "name": "api-session/added",
        "mode": "emit"
      },
      {
        "name": "api-session/error",
        "mode": "emit"
      },
      {
        "name": "api-session/removed",
        "mode": "emit"
      },
      {
        "name": "api-session/status",
        "mode": "emit"
      },
      {
        "name": "approval/request",
        "mode": "waterfall"
      },
      {
        "name": "commands/change",
        "mode": "emit"
      },
      {
        "name": "control/state-changed",
        "mode": "emit"
      },
      {
        "name": "cordis/dynamic-package",
        "mode": "emit"
      },
      {
        "name": "cordis/dynamic-retract",
        "mode": "emit"
      },
      {
        "name": "cordis/inspect-query",
        "mode": "emit"
      },
      {
        "name": "cordis/inspect-query-resolved",
        "mode": "emit"
      },
      {
        "name": "cordis/request-run",
        "mode": "emit"
      },
      {
        "name": "cordis/request-run-resolved",
        "mode": "emit"
      },
      {
        "name": "credentials/reference-updated",
        "mode": "emit"
      },
      {
        "name": "domain/changed",
        "mode": "emit"
      },
      {
        "name": "fs/observed",
        "mode": "emit"
      },
      {
        "name": "goal/activation-changed",
        "mode": "emit"
      },
      {
        "name": "internal/plugin",
        "mode": "emit"
      },
      {
        "name": "llm/adapters-updated",
        "mode": "emit"
      },
      {
        "name": "session/created",
        "mode": "emit"
      },
      {
        "name": "session/disposed",
        "mode": "emit"
      },
      {
        "name": "session/event",
        "mode": "emit"
      },
      {
        "name": "settings/document-updated",
        "mode": "emit"
      },
      {
        "name": "system-prompt/assemble",
        "mode": "waterfall"
      },
      {
        "name": "user-questions/request",
        "mode": "waterfall"
      },
      {
        "name": "webserver/index-inject",
        "mode": "emit"
      }
    ]
  },
  "dependencies": {
    "@deepseek-ai/dsh-agent-presets": "workspace:^",
    "@deepseek-ai/dsh-api-remotes": "workspace:^",
    "@deepseek-ai/dsh-api-session-controller": "workspace:^",
