{
  "name": "@deepseek-ai/dsh-schema-registry",
  "description": "Unified Schema Registry with versioning, compatibility rules, and migration functions for persistent and wire-protocol objects",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/schema/schema-registry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types.js"
    },
    "./migrate": {
      "types": "./lib/types/migrate.d.ts",
      "default": "./lib/migrate.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types.js",
    "lib/migrate.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "private": true
}
