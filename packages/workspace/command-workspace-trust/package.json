    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@deepseek-ai/dsh-user-approval": "workspace:^",
    "@deepseek-ai/dsh-workspace-trust": "workspace:^",
    "@deepseek-ai/dsh-workspace-trust-local": "workspace:^"
  }
