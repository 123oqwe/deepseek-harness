{
  "name": "@deepseek-ai/dsh-tool-cordis",
  "description": "Self-referential cordis toolset: inspect the live runtime, mount and dispose model-written plugins",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/extensions/tool-cordis"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-cordis-host-runner": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-loader": "workspace:^",
    "@deepseek-ai/dsh-agent": "workspace:^",
    "@deepseek-ai/dsh-cordis-host-runner": "workspace:^",
    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-scope": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-system-prompt": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dsh": {
    "manifestVersion": 2,
    "executionMode": "in-process",
    "compatibility": {
      "dshVersionRange": ">=0.1.0 <0.2.0"
    },
    "tools": [
      {
        "name": "cordis_inspect_list",
        "sideEffectClass": "read",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "internal"
      },
      {
        "name": "cordis_inspect_query",
        "sideEffectClass": "read",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "internal"
      },
      {
        "name": "cordis_inspect_self",
        "sideEffectClass": "read",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "confidential"
      },
      {
        "name": "cordis_define",
        "sideEffectClass": "write",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "confidential"
      },
      {
        "name": "cordis_run",
        "sideEffectClass": "process",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [
          {
            "kind": "process",
            "commandPattern": "*"
          },
          {
            "kind": "network",
            "hostPattern": "*"
          },
          {
            "kind": "filesystem",
            "pathPattern": "/"
          }
        ],
        "dataClassification": "confidential"
      },
      {
        "name": "cordis_stop",
        "sideEffectClass": "write",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "internal"
      },
      {
        "name": "cordis_undefine",
        "sideEffectClass": "destructive",
        "authAudience": [
          "model"
        ],
        "allowedDestinations": [],
        "dataClassification": "internal"
      }
    ],
    "events": [
      {
        "name": "agent/pre-step",
        "mode": "waterfall"
      }
    ]
  }
}
