{
  "name": "@deepseek-ai/dsh-plugin-migrations",
  "description": "Plugin data-migration vocabulary and decisions for Epic P1-10: the manifest's migration DAG, preconditions, backup strategy and rollback support, plus the pure judgements over them — is this DAG acyclic, is this upgrade path admissible, is this migration reversible, and is a snapshot reconcilable with the data it was taken from",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/plugin/plugin-migrations"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./transaction": {
      "types": "./lib/types/transaction.d.ts",
      "default": "./lib/types/transaction.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-atomic-write": "workspace:^"
  }
}
