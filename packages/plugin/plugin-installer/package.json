{
  "name": "@deepseek-ai/dsh-plugin-installer",
  "description": "Plugin-package installer for Epic P1-04 (A): it extracts a plugin archive in quarantine with install scripts disabled and path-traversal, symlink and decompression-ratio rejection, verifies its provenance (P1-02), and promotes it atomically, published as ctx.pluginInstaller",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/plugin/plugin-installer"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/dsh-plugin-provenance": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^",
    "tar": "^7.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-trust-kernel": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-trust-kernel": "workspace:^"
  }
}
