    "@deepseek-ai/dsh-llm": "workspace:^",
    "@deepseek-ai/dsh-resource-budget": "workspace:^",
    "@deepseek-ai/dsh-run": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-task-profile": "workspace:^",
    "@deepseek-ai/dsh-util-values": "workspace:^",
    "ajv": "^8.20.0",
    "canonicalize": "2.1.0"
  }
}
