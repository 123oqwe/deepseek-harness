{
  "name": "@deepseek-ai/dsh-memory-policy",
  "description": "P6-03 memory proposal policy: decides whether a candidate memory write is auto-accepted, sent to human review, or rejected, and mounts the memoryProposalPolicy service dsh-memory consults",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/memory/memory-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-memory": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
