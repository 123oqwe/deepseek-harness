{
  "name": "@deepseek-ai/dsh-approval-store",
  "description": "The durable approval queue for Epic P2-07: an approval's six states (requested, approved, denied, expired, revoked, consumed) and the moves between them, the record a store keeps (request digest, policy version, actor, deadline, tenant), the compare-and-swap store operations every provider implements, the pure transition decisions each provider applies, and the SQLite provider published as ctx.approvalStore",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./types": {
        "types": "./lib/types/types.d.ts",
        "default": "./lib/types/types.js"
      },
      "./sqlite": {
        "types": "./lib/types/sqlite.d.ts",
        "default": "./lib/types/sqlite.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/interaction/approval-store"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./sqlite": {
      "types": "./lib/types/sqlite.d.ts",
      "default": "./lib/types/sqlite.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^"
  }
}
