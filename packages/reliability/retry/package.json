{
  "name": "@deepseek-ai/dsh-retry",
  "description": "Retry decision vocabulary for Epic P4-11: the failure taxonomy and its retryability read against the action ledger's reconciliation state, one run-wide retry budget every layer accounts against, and the hedge-exclusion rule \u2014 pure and total, with backoff left to the existing llm-retry implementation this epic unifies rather than replaces",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/reliability/retry"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./usage": {
      "types": "./lib/types/usage.d.ts",
      "default": "./lib/types/usage.js"
    },
    "./classify": {
      "types": "./lib/types/classify.d.ts",
      "default": "./lib/types/classify.js"
    },
    "./budget": {
      "types": "./lib/types/budget.d.ts",
      "default": "./lib/types/budget.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-action-ledger": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-action-ledger": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
