{
  "name": "@deepseek-ai/dsh-grant-store",
  "description": "Reusable scoped, expiring capability grants for Epic P2-08's first slice: the grant vocabulary (actor/capability/resource predicates, amount/use/time-window limits, environment, expiry, revocation), pure validation that refuses unscoped or permanent drafts, predicate-only matching where the stricter of two covering grants decides, and an in-process store plus a fail-closed worker view whose revocations reach every worker at its next authorization",
  "version": "0.1.5-rc.2",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./lib/types/index.d.ts",
        "default": "./lib/index.js"
      },
      "./types": {
        "types": "./lib/types/types.d.ts",
        "default": "./lib/types/types.js"
      },
      "./match": {
        "types": "./lib/types/match.d.ts",
        "default": "./lib/types/match.js"
      },
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/policy/grant-store"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./match": {
      "types": "./lib/types/match.d.ts",
      "default": "./lib/types/match.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  }
}
