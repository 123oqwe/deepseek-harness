{
  "name": "@deepseek-ai/dsh-policy-engine-cedar",
  "description": "Policy provider for Epic P2-05: mounts ctx.policy over a Cedar authorizer, translating a harness policy request into Cedar's entity and context shape and its answer back into a closed decision, with the policy set validated at load and its digest recorded on every decision",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/policy/policy-engine-cedar"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@cedar-policy/cedar-wasm": "4.12.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-action-manifest": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-policy-engine": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-action-manifest": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-capability-token": "workspace:^",
    "@deepseek-ai/dsh-policy-engine": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  }
}
