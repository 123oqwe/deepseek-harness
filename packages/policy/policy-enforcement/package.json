{
  "name": "@deepseek-ai/dsh-policy-enforcement",
  "description": "The Policy Enforcement Point for Epic P2-05: one place every originator's action is decided, with the decision from ctx.policy, plugin constraints that can only narrow it, and the binding and the audit append performed by the pinned Trust Kernel",
  "version": "0.1.2-alpha.4",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/policy/policy-enforcement"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-policy-engine": "workspace:^",
    "@deepseek-ai/dsh-trust-kernel": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-action-manifest": "workspace:^",
    "@deepseek-ai/dsh-brand": "workspace:^",
    "@deepseek-ai/dsh-policy-engine": "workspace:^",
    "@deepseek-ai/dsh-policy-engine-cedar": "workspace:^",
    "@deepseek-ai/dsh-principal": "workspace:^",
    "@deepseek-ai/dsh-trust-kernel": "workspace:^"
  }
}
