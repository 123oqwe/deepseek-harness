  "allowlist": [
    {
      "kind": "missing-provider",
      "from": "@deepseek-ai/dsh-authorization",
      "to": "@deepseek-ai/dsh-authorization",
      "reason": "Flows are registered by the plugin that knows how to obtain one credential (e.g. dsh-llm-pi-ai), keyed by the record it writes, rather than by a dedicated Service Provider package; the seam owns the conversation and one-attempt-per-key lifecycle, never the protocol. Revisit when the U-stage scanner can distinguish a registration-based provider from a package-based one.",
      "owner": "harryqiao59@gmail.com",
      "removalDate": "2026-12-01"
    },
    {
      "kind": "missing-provider",
      "from": "@deepseek-ai/dsh-user-questions",
      "to": "@deepseek-ai/dsh-user-questions",
      "reason": "UI front ends register the active human-answer provider directly against the seam rather than shipping a separate provider package; no dedicated Service Provider package exists today. Revisit alongside the authorization allowlist entry above once registration-based providers have their own detection rule.",
      "owner": "harryqiao59@gmail.com",
      "removalDate": "2026-12-01"
    }
  ]
}
